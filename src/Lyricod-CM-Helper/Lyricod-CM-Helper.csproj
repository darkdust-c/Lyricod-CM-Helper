<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- No window: Lyricod runs it and reads what happened from the result file. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LyricodCMHelper</RootNamespace>
    <AssemblyName>Lyricod-CM-Helper</AssemblyName>
    <Version>1.0.1</Version>
    <Authors>Lyricod</Authors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- One small exe that needs no .NET installed. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Windows' signature check (WinVerifyTrust) takes pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lyricod-CM-Helper.Tests" />
  </ItemGroup>
</Project>
